{
  "name": "supdance",
  "description": "SupDance AI Studio - Next-Gen Generative AI Creative Platform",
  "homepage": "https://www.supdance.com",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/studio",
    "packages/Vibe-Workflow/packages/workflow-builder",
    "packages/Open-Poe-AI/packages/agents",
    "packages/Open-AI-Design-Agent/packages/design-agent"
  ],
  "scripts": {
    "dev": "node scripts/require-database-url.mjs && next dev",
    "build": "next build",
    "start": "node scripts/require-database-url.mjs && next start",
    "lint": "next lint",
    "format:check": "node scripts/check-format.mjs",
    "release:check": "node scripts/release-safety-check.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:test": "node scripts/migrate-test.mjs",
    "db:seed:community-cases": "node --experimental-loader ./scripts/server-only-loader.mjs scripts/seed-community-cases.mjs",
    "db:status": "node scripts/db-status.mjs",
    "storage:migration-report": "node scripts/storage-migration-report.mjs",
    "assets:retention": "node --experimental-loader ./scripts/server-only-loader.mjs scripts/asset-trash-retention.mjs",
    "pricing:sync": "node --env-file=.env.local --experimental-loader ./scripts/server-only-loader.mjs scripts/seed-formula-pricing.mjs",
    "test:db": "node scripts/run-isolated-pg-tests.mjs",
    "run-isolated-pg-tests": "node scripts/run-isolated-pg-tests.mjs",
    "migration:drill": "node scripts/migration-drill.mjs",
    "backup:restore:drill": "node scripts/backup-restore-drill.mjs",
    "test:router": "node --test --env-file=.env.local --experimental-loader ./scripts/server-only-loader.mjs tests/smart-router-scoring.test.mjs tests/model-pricing-routing.test.mjs",
    "test:billing": "node --test --env-file=.env.local --experimental-loader ./scripts/server-only-loader.mjs tests/p6/*.test.mjs",
    "test:storage": "node --test --experimental-loader ./scripts/server-only-loader.mjs tests/p5/unified-storage.test.mjs tests/p5/asset-storage.test.mjs tests/p5/sharp-variants.test.mjs",
    "test:all:isolated": "node scripts/run-all-tests-isolated.mjs",
    "test:e2e": "playwright test",
    "verify:build": "node scripts/verify-build-assets.mjs .next",
    "verify:production-assets": "node scripts/verify-production-assets.mjs --base https://www.supdance.com --pages /,/login,/register,/studio",
    "verify:canvas-assets": "node scripts/verify-production-assets.mjs --base https://canvas.supdance.com --pages /",
    "china-ip:generate": "node scripts/generate-china-ip-module.mjs",
    "china-ip:check": "node scripts/generate-china-ip-module.mjs --check",
    "test:ci": "npm run format:check && npm run lint && npm run release:check && npm run lint:routes && npm run security:secrets && npm run test:i18n && npm run china-ip:check && npm run test:all:isolated && npm run test:db && npm run build:studio && npm run vite:build && npm run build && npm run verify:build",
    "test:i18n": "node scripts/test-i18n.mjs && node scripts/validate-i18n.mjs --strict",
    "test:content": "node --experimental-loader ./scripts/server-only-loader.mjs scripts/test-content-management.mjs",
    "backup:db": "node scripts/auto-backup-s3.mjs",
    "verify:admin": "node scripts/verify-phase1.mjs && node scripts/verify-phase2.mjs && node scripts/verify-phase3.mjs && node scripts/verify-phase4.mjs",
    "build:studio": "npm run build -w studio && rsync -a packages/studio/src/ node_modules/studio/src/ && rsync -a packages/studio/dist/ node_modules/studio/dist/",
    "build:workflow": "npm run build -w workflow-builder",
    "build:agent": "npm run build -w ai-agent",
    "build:design": "npm run build -w design-agent",
    "build:packages": "npm run build:workflow && npm run build:agent && npm run build:design && npm run build:studio",
    "worker:generation:supervised": "node scripts/require-database-url.mjs && node scripts/generation-worker-supervisor.mjs",
    "setup": "git submodule update --init --recursive && npm install && npm run build:packages",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "electron:dev": "npm run vite:build && electron .",
    "electron:build": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:linux:dir": "vite build && electron-builder --linux dir",
    "electron:build:linux:arm64:dir": "vite build && electron-builder --linux dir --arm64",
    "stage:local-ai": "node scripts/stage-local-ai-binary.js",
    "package:linux:deb": "node scripts/package-linux-deb.js",
    "package:linux:deb:arm64": "node scripts/package-linux-deb.js --arch arm64",
    "package:linux:deb:x64": "node scripts/package-linux-deb.js --arch x64",
    "electron:build:all": "vite build && electron-builder --mac --win --linux",
    "route:map": "node scripts/route-map.mjs",
    "lint:routes": "node scripts/route-map.mjs --check",
    "lint:routes:update": "node scripts/route-map.mjs --update"
  },
  "build": {
    "appId": "ai.generative.open",
    "productName": "SupDance",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "release"
    },
    "afterPack": "./afterPack.js",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/local-ai",
        "to": "local-ai",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "public/banner.png",
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/banner.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "public/banner.png",
      "category": "Utility",
      "maintainer": "SupDance Team",
      "extraFiles": [
        {
          "from": "build/linux/apparmor.profile",
          "to": "resources/apparmor.profile"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@ant-design/icons": "^6.3.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "agent-twitter-client": "^0.0.18",
    "ai-agent": "file:./packages/Open-Poe-AI/packages/agents",
    "ajv": "^8.20.0",
    "antd": "^6.6.7",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "firebase": "12.19.0",
    "libphonenumber-js": "^1.13.13",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.61.0",
    "next": "15.5.26",
    "next-intl": "^4.14.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "stripe": "^22.6.2",
    "studio": "file:./packages/studio",
    "tencentcloud-sdk-nodejs-captcha": "^4.1.315",
    "tencentcloud-sdk-nodejs-sms": "^4.1.306",
    "workflow-builder": "file:./packages/Vibe-Workflow/packages/workflow-builder",
    "xtend": "^4.0.2"
  },
  "overrides": {
    "postcss": "8.5.28",
    "prismjs": "1.30.0",
    "uuid": "11.1.1",
    "@tootallnate/once": "2.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "playwright-core": "^1.62.1",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0"
  },
  "main": "electron/main.js"
}
